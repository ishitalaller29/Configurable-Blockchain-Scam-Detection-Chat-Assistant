# Copy this file to .env and fill in the values you need.
# Real environment variables override .env (handy for Docker/CI).
# Never commit .env - it's already in .gitignore.

# --- Default LLM backend ---
# openai_compatible (default, e.g. local Ollama), openai, gemini or anthropic
LLM_PROVIDER=openai_compatible
# Model name for the native providers (openai / gemini / anthropic)
# LLM_MODEL=

# --- Native LLM provider keys (only the one you use) ---
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=

# --- Ollama (used by the openai_compatible backend defaults) ---
# docker-compose sets OLLAMA_BASE_URL to http://ollama:11434/v1 for you
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=llama3.1

# --- Fetchers ---
# Required: the contract / token / tx-history fetchers fail without it
ETHERSCAN_API_KEY= 
# Where DexScreener liquidity results are cached
# DEXSCREENER_CACHE_PATH=dexscreener_liquidity_cache.json

# --- Detectors ---
# Overrides "active_detector" in config/app_config.json (use "none" for the Scam Checker)
# ACTIVE_DETECTOR=
# Only needed for the rektradar detector (its auth is optional)
# REKTRADAR_API_KEY=
